.venv/
venv/
__pycache__/
*.pyc
.idea/
exportToHTML/

# Local preferences (window geometry, task phrase, camera index)
/settings.json

# Recorded data — stays on the machine that made it.
# /study/ may contain human-subjects data and must never be published.
# These are anchored with a leading slash so they match only the repo root:
# unanchored "study/" also matched web/study/, silently dropping app code.
/session_history.csv
/session_charts/
/demo_logs/
/study/
/focus_session*.csv
/models/*.joblib
/models/*.png

# Web app
web/node_modules/
.vercel

# Participant data must never land in web/ - everything there is PUBLISHED by
# the deployment, so a stray export would be downloadable by anyone with the
# URL. fetch_study_data.py refuses to write here; this is the second lock.
web/**/*.csv
web/**/*.sqlite
web/study/*.json
!web/data/*.json
